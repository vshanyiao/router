# Production image for the Next.js web app.
#
# REQUIRES `output: 'standalone'` in web/next.config.ts. Without it, the
# `.next/standalone` directory (and server.js) is not produced and the runner
# stage below will fail. Add to next.config.ts:
#
#   const nextConfig: NextConfig = {
#     output: 'standalone',
#   };

# ---- Builder ----------------------------------------------------------------
FROM node:22-alpine AS builder

WORKDIR /app

# pnpm 11 requires Node 22+. Pin the version so corepack does not pull a newer
# release that breaks on this base image.
RUN corepack enable && corepack prepare pnpm@11.1.0 --activate

COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile

COPY . .

# Generate the Prisma client, then build with Next standalone output.
RUN pnpm prisma generate
RUN pnpm build

# ---- Runner -----------------------------------------------------------------
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Run as an unprivileged user.
RUN addgroup -g 1001 -S nodejs \
  && adduser -u 1001 -S nextjs -G nodejs

# The standalone output bundles a minimal node_modules and server.js; static
# assets and public/ must be copied alongside it.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

CMD ["node", "server.js"]
